{
  "_provenance": "Copy of aml/ops/personas/imhotep/task-object.schema.json (JSON Schema draft 2020-12). Original $schema/$id URLs removed for packaging; original id: schemas.sissa.dev task-object.schema.json",
  "title": "SISSA Task Object",
  "type": "object",
  "required": [
    "task_name",
    "owner",
    "status",
    "source_reference",
    "memory_correlation"
  ],
  "properties": {
    "task_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "In Progress",
        "Blocked",
        "Review",
        "Complete"
      ]
    },
    "source_reference": {
      "type": "string",
      "minLength": 3
    },
    "memory_correlation": {
      "type": "object",
      "required": [
        "neuron",
        "date",
        "context"
      ],
      "properties": {
        "neuron": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "context": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A[0-9]{2}_.+"
          }
        },
        "risk": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "notes": {
              "type": "string",
              "maxLength": 200
            }
          },
          "additionalProperties": false
        },
        "kpi": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "reasoning_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Bayesian",
              "Deterministic",
              "RHL",
              "Socratic",
              "Allegorical"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "label",
          "url"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "last_updated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
